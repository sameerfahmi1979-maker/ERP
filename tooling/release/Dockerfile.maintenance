# Temporary maintenance bridge: same pinned runtime as the approved ERP artifact.
FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
WORKDIR /app
ENV NODE_ENV=production PORT=8080
COPY --chown=node:node public/maintenance.html ./public/maintenance.html
COPY --chown=node:node tooling/release/maintenance-server.cjs ./tooling/release/maintenance-server.cjs
USER node
EXPOSE 8080
CMD ["node", "tooling/release/maintenance-server.cjs"]
