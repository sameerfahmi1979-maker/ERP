{
  "name": "erp-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--use-system-ca --max-old-space-size=16384\" next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 next build --webpack",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=16384 next start",
    "lint": "eslint src next.config.ts",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsc --project tsconfig.shipping.json --noEmit",
    "memory:check": "cross-env NODE_OPTIONS=--max-old-space-size=16384 node scripts/check-node-memory.mjs",
    "bootstrap:admin": "cross-env NODE_OPTIONS=--max-old-space-size=16384 node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "test": "vitest run",
    "test:f01": "vitest run --config tests/remediation/f01/vitest.config.mts",
    "security:secrets": "node tooling/security/scan-secrets.cjs",
    "test:remediation": "vitest run --config tests/remediation/vitest.config.mts",
    "schema:types": "node tooling/schema/generate-types.cjs",
    "test:watch": "vitest",
    "test:e2e": "cross-env NODE_OPTIONS=--use-system-ca playwright test",
    "test:e2e:headed": "cross-env NODE_OPTIONS=--use-system-ca playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@napi-rs/canvas": "^1.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "bidi-shaper": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.3.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "openai": "^6.44.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
